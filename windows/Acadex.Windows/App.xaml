<Application x:Class="Acadex.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Acadex.Windows.Converters"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    <conv:PageVisibilityConverter x:Key="PageVisibility"/>
    <Color x:Key="AccentColor">#7778F6</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#111218"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#191B25"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#202330"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F5FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9DA2B6"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2C3040"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#43C99A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7979"/>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#12141B"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,4,0,12"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#12141B"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,4,0,12"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Application.Resources>
</Application>